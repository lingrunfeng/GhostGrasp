Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 0.25
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: world
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Description File: ""
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Name: RobotModel
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.15
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Tree:
        {}
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: RGB Image
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /ghost_mgg/d435/color/image_raw
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 2
      Median window: 5
      Min Value: 0
      Name: Raw Depth Preview
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /ghost_mgg/d435/depth/image_viz
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 2
      Median window: 5
      Min Value: 0
      Name: M3 Corrupted Depth Preview
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /ghost_mgg/d435/depth/m3_image_viz
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 255
      Median window: 1
      Min Value: 0
      Name: Target Mask
      Normalize Range: false
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /ghost_mgg/d435/target_mask
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 255
      Median window: 1
      Min Value: 0
      Name: Hole Evidence
      Normalize Range: false
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /ghost_mgg/d435/evidence/hole_mask
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 255
      Median window: 1
      Min Value: 0
      Name: Table Leakage Evidence
      Normalize Range: false
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /ghost_mgg/d435/evidence/table_leakage_mask
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 255
      Median window: 1
      Min Value: 0
      Name: Edge Evidence
      Normalize Range: false
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /ghost_mgg/d435/evidence/edge_mask
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 255
      Median window: 1
      Min Value: 0
      Name: Flying Point Evidence
      Normalize Range: false
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /ghost_mgg/d435/evidence/flying_point_mask
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 255
      Median window: 1
      Min Value: 0
      Name: Biased Depth Evidence
      Normalize Range: false
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /ghost_mgg/d435/evidence/biased_depth_mask
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: false
      Max Value: 255
      Median window: 1
      Min Value: 0
      Name: IR Left Proxy
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /ghost_mgg/d435/infra1/image_rect_raw
      Value: false
    - Class: rviz_default_plugins/Image
      Enabled: false
      Max Value: 255
      Median window: 1
      Min Value: 0
      Name: IR Right Proxy
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /ghost_mgg/d435/infra2/image_rect_raw
      Value: false
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: z
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: Raw Depth Points
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.004
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /ghost_mgg/d435/depth/points
      Use Fixed Frame: true
      Value: true
    - Alpha: 0.75
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: z
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 180; 0
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: M3 Corrupted Depth Points
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.006
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /ghost_mgg/d435/depth/m3_points
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Hypothesis Markers
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ghost_mgg/hypothesis_markers
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: M4 Real Ranking Markers
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ghost_mgg/m4_real_ranking_markers
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: M4 Graspability Markers
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ghost_mgg/m4_graspability_markers
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: M4 Sim Grasp Markers
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ghost_mgg/m4_sim_grasp_markers
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: M4 Sim MoveIt Plan Markers
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ghost_mgg/m4_sim_moveit_plan_markers
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: M4 Joint Hypothesis Markers
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ghost_mgg/m4_joint_hypothesis_markers
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: M4 Joint Contract Markers
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ghost_mgg/m4_joint_contract_markers
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.5
      Focal Point:
        X: 0.05
        Y: 0.04
        Z: 0.78
      Name: Orbit
      Pitch: 0.70
      Target Frame: world
      Yaw: 3.75
    Saved: ~
Window Geometry:
  Height: 950
  Width: 1400
