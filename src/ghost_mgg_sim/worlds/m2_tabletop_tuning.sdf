<?xml version="1.0"?>
<sdf version="1.9">
  <world name="ghost_mgg_m2_tuning">
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <scene>
      <ambient>0.55 0.58 0.62 1</ambient>
      <background>0.78 0.84 0.90 1</background>
      <shadows>false</shadows>
    </scene>

    <light name="key_light" type="directional">
      <pose>-1.5 -2.0 4.0 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.95 0.92 0.86 1</diffuse>
      <specular>0.35 0.35 0.35 1</specular>
      <direction>-0.55 0.18 -1.0</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>5 5</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>5 5</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.50 0.53 0.52 1</ambient>
            <diffuse>0.64 0.67 0.66 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <name>table</name>
      <uri>model://table</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <include>
      <name>red_cube</name>
      <uri>model://red_cube</uri>
      <pose>0.070172 0.012156 0.752500 0 0 0</pose>
    </include>

    <include>
      <name>blue_cylinder</name>
      <uri>model://blue_cylinder</uri>
      <pose>0.139726 -0.034920 0.752500 0 0 0</pose>
    </include>

    <include>
      <name>green_cylinder</name>
      <uri>model://green_cylinder</uri>
      <pose>-0.035000 -0.047344 0.752500 0 0 0</pose>
    </include>

    <include>
      <name>glass_block</name>
      <uri>model://glass_block</uri>
      <pose>0.002000 0.100000 0.752500 0 0 0</pose>
    </include>
  </world>
</sdf>
