<?xml version="1.0"?>
<sdf version="1.9">
  <world name="ghost_mgg_m2_visual">
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <scene>
      <ambient>0.55 0.58 0.62 1</ambient>
      <background>0.78 0.84 0.90 1</background>
      <shadows>false</shadows>
    </scene>

    <light name="key_light" type="directional">
      <pose>-1.5 -2.0 4.0 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.95 0.92 0.86 1</diffuse>
      <specular>0.35 0.35 0.35 1</specular>
      <direction>-0.55 0.18 -1.0</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>5 5</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>5 5</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.50 0.53 0.52 1</ambient>
            <diffuse>0.64 0.67 0.66 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <name>table</name>
      <uri>model://table</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <include>
      <name>d435_stand_only</name>
      <uri>model://d435_stand_only</uri>
      <pose>0.410788 -0.079176 0.740000 0 0 -0.386880</pose>
    </include>

    <include>
      <name>d435_camera_head</name>
      <uri>model://d435_camera_head</uri>
      <pose>0.286775 -0.079936 1.105590 0 0.950000 2.754700</pose>
    </include>

    <include>
      <name>red_cube</name>
      <uri>model://red_cube</uri>
      <pose>0.070172 0.012156 0.752500 0 0 0</pose>
    </include>

    <include>
      <name>blue_cylinder</name>
      <uri>model://blue_cylinder</uri>
      <pose>0.115000 0.075000 0.752500 0 0 0</pose>
    </include>

    <include>
      <name>green_cylinder</name>
      <uri>model://green_cylinder</uri>
      <pose>-0.035000 -0.047344 0.752500 0 0 0</pose>
    </include>

    <include>
      <name>glass_block</name>
      <uri>model://glass_block</uri>
      <pose>0.002000 0.100000 0.752500 0 0 0</pose>
    </include>

    <model name="nurse_abstract_target">
      <pose>0.029075 0.189698 0.769565 1.570800 -0.000001 1.027280</pose>
      <static>false</static>
      <link name="body">
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/nurse/2/files/meshes/Nurse.obj</uri>
              <scale>0.12 0.12 0.12</scale>
            </mesh>
          </geometry>
        </visual>
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/nurse/2/files/meshes/Nurse_Col.obj</uri>
              <scale>0.12 0.12 0.12</scale>
            </mesh>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.9</mu>
                <mu2>0.9</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <inertial>
          <pose>0 0 0.102 0 0 0</pose>
          <mass>0.005</mass>
          <inertia>
            <ixx>1e-06</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1e-06</iyy>
            <iyz>0</iyz>
            <izz>1e-06</izz>
          </inertia>
        </inertial>
      </link>
      <self_collide>false</self_collide>
    </model>
  </world>
</sdf>
