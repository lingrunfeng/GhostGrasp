    <model name="m8_unknown_blob_target">
      <pose>-0.145 0.085 0.760000 0 0 -0.350</pose>
      <static>false</static>
      <link name="body">
        <inertial><mass>0.020</mass><inertia><ixx>0.000002</ixx><iyy>0.000002</iyy><izz>0.000002</izz></inertia></inertial>
        <visual name="core"><geometry><sphere><radius>0.020</radius></sphere></geometry><material><ambient>0.35 0.70 0.20 1</ambient><diffuse>0.35 0.70 0.20 1</diffuse></material></visual>
        <visual name="lobe"><pose>0.018 0.010 -0.004 0 0 0</pose><geometry><sphere><radius>0.014</radius></sphere></geometry><material><ambient>0.25 0.60 0.18 1</ambient><diffuse>0.25 0.60 0.18 1</diffuse></material></visual>
        <collision name="core_collision"><geometry><sphere><radius>0.020</radius></sphere></geometry></collision>
        <collision name="lobe_collision"><pose>0.018 0.010 -0.004 0 0 0</pose><geometry><sphere><radius>0.014</radius></sphere></geometry></collision>
      </link>
    </model>

    <model name="nurse_abstract_target">
      <pose>0.015 0.175 0.769565 1.570800 -0.000001 1.027280</pose>
      <static>false</static>
      <link name="body">
        <visual name="visual">
          <geometry><mesh><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/nurse/2/files/meshes/Nurse.obj</uri><scale>0.12 0.12 0.12</scale></mesh></geometry>
        </visual>
        <collision name="collision">
          <geometry><mesh><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/nurse/2/files/meshes/Nurse_Col.obj</uri><scale>0.12 0.12 0.12</scale></mesh></geometry>
        </collision>
        <inertial><pose>0 0 0.102 0 0 0</pose><mass>0.005</mass><inertia><ixx>1e-06</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-06</iyy><iyz>0</iyz><izz>1e-06</izz></inertia></inertial>
      </link>
    </model>
  </world>
</sdf>
