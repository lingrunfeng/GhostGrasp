        <collision name="right_collision"><pose>0.018 0 0 0 0 0</pose><geometry><box><size>0.012 0.050 0.020</size></box></geometry></collision>
        <collision name="base_collision"><pose>0 -0.019 0 0 0 0</pose><geometry><box><size>0.048 0.012 0.020</size></box></geometry></collision>
